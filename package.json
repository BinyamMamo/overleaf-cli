{
  "name": "@binyammamo/overleaf-cli",
  "version": "0.14.0-olf.0",
  "description": "overleaf-cli (olf): olcli fork with browser login and live, cooperative editing between you and an AI agent on Overleaf",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "olf": "dist/cli.js",
    "overleaf-cli": "dist/cli.js",
    "olf-mcp": "dist/mcp.js",
    "git-remote-olf": "dist/remote-helper.js"
  },
  "scripts": {
    "build": "tsc",
    "mcp": "node dist/mcp.js",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src/",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "overleaf",
    "overleaf-cli",
    "latex",
    "latex-cli",
    "cli",
    "command-line",
    "sync",
    "tex",
    "pdf",
    "academic",
    "writing",
    "latex-editor",
    "overleaf-sync",
    "research",
    "compile",
    "arxiv",
    "terminal",
    "typescript",
    "latex-tools"
  ],
  "author": "Alexander Loth <alex@alexloth.com> (https://alexloth.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinyamMamo/overleaf-cli.git"
  },
  "bugs": {
    "url": "https://github.com/BinyamMamo/overleaf-cli/issues"
  },
  "homepage": "https://github.com/BinyamMamo/overleaf-cli#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.16",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.5",
    "ora": "^8.0.1",
    "playwright-core": "^1.64.1",
    "tough-cookie": "^4.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@types/tough-cookie": "^4.0.5",
    "eslint": "^9.39.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "private": true
}
