{
  "manifest_version": 3,
  "name": "olf for Overleaf",
  "version": "0.2.0",
  "description": "Shows which sections an olf agent is editing in Overleaf, and asks before you type in them. Optional: olf works without it.",
  "host_permissions": [
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "olf for Overleaf",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
