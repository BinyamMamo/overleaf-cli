{
  "manifest_version": 3,
  "name": "olf for Overleaf",
  "version": "0.3.0",
  "description": "See and steer what your olf agent does in Overleaf: claimed sections, suggestions to accept, task history with undo, and Git snapshots. Optional: olf works without it.",
  "host_permissions": [
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open the olf panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
